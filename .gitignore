# Dependencies
node_modules/

# Build output
dist/
coverage/
dev-dist/

# Vite / TS
*.tsbuildinfo

# Logs
npm-debug.log*
*.log

# Extraction tools (binaries — not part of the repo; see src/pipeline/EXTRACTION.md)
FModel.exe

# FModel working dirs — keep the JSON exports (Output/Exports, the normalizer's input),
# drop the ~1.1 GB local pak cache and transient logs/backups.
Output/.data/
Output/Logs/
Output/Backups/

# Raw texture export tree — normalize.ts copies the icons it needs into public/icons/pals
# (the real output the app serves); no reason to also carry the ~30MB source dump in git.
Output/Exports/**/Texture/

# Editor / OS
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
Thumbs.db

# Local env
.env
.env.local
.env.*.local

# Personal SteamID64 -> display name seed data — see src/store/nameOverrides.example.ts
src/store/nameOverrides.local.ts

# Python (proxy/)
__pycache__/
*.pyc
.pytest_cache/
.venv/
venv/

# Personal scratch notes — not project docs
UI_Enhancements.txt
