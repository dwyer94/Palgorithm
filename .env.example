# Copy to .env.local (gitignored) to enable the opt-in cloud sync layer (Phase 1,
# docs/PRODUCTION_READINESS_PLAN.md). Leave unset and the app runs fully guest/local-only,
# same as before this feature existed — see src/store/supabaseClient.ts.
#
# Both values come from your Supabase project's Settings -> API page. VITE_SUPABASE_ANON_KEY
# is the public "anon" key, safe to ship in a client bundle — never put the service_role key
# here or anywhere under src/ (the CI service_role tripwire greps for this exact mistake).
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
