# Copy to .env (already gitignored at the repo root) and fill in for a real deployment.
# Leaving PALDEFENDER_TOKEN unset runs the proxy in demo mode (canned fixture data,
# no PalDefender required) — useful for testing the app<->proxy wire before PalDefender
# and Tailscale (see ../docs/SETUP_admin_runbook.md) are set up.

# PalDefender's REST API. VERIFY the port against your PalDefender config.
PALDEFENDER_BASE=http://127.0.0.1:8213
PALDEFENDER_TOKEN=

# Optional: require callers to send `Authorization: Bearer <PROXY_TOKEN>`. Leave unset to
# rely purely on Tailscale network access as the gate (no auth check of its own).
PROXY_TOKEN=

# Comma-separated list of allowed origins for the app's browser requests, or `*` for any
# origin. Defaults to `*` since Tailscale already gates who can reach this proxy at all.
CORS_ORIGINS=*

# Seconds to cache upstream PalDefender responses per endpoint+identifier, to avoid hammering
# the game server's REST API (which has its own 5s game-thread timeout per docs/PalDefenderAPI/*.md).
CACHE_TTL_SECONDS=5

# Force demo mode even if PALDEFENDER_TOKEN is set. Leave unset/false for normal operation.
DEMO_MODE=
